        {
          "name": "PATCH Deactivate vehicle",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}/deactivate", "host": ["{{baseUrl}}"], "path": ["api", "vehicles", "{{vehicleId}}", "deactivate"] },
            "description": "Soft-disables the vehicle (active=false) without deleting the record - e.g. the vehicle failed inspection or is temporarily off the road."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('vehicle is inactive', function () { pm.expect(pm.response.json().active).to.eql(false); });"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/api/vehicles/1/deactivate", "host": ["{{baseUrl}}"], "path": ["api", "vehicles", "1", "deactivate"] } },
              "status": "OK",
              "code": 200,
